#!/bin/sh
# vfs495-driver: restart fprintd after every resume (systemd runs this with "pre" or "post").
#
# fprintd runs permanently (--no-timeout, see the fprintd drop-in). On this laptop the USB
# controller is often reinitialised on resume and the reader comes back at a new address;
# libfprint then adds the new reader without always dropping the old one, and GNOME, using the
# first, finds no reader. A fresh fprintd knows only the current one. --no-block: the restart
# (about 0.3 s) must not hold up the resume.
case "$1" in
post)
	systemctl --no-block try-restart fprintd.service >/dev/null 2>&1 || true
	;;
esac
exit 0
