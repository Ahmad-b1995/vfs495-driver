#!/bin/sh
set -e
if [ "$1" = configure ]; then
	# left by the manual install that preceded this package (driver/tools/install-driver.sh)
	rm -f /etc/systemd/system/fprintd.service.d/vfs495-driver.conf
	rmdir --ignore-fail-on-non-empty /etc/systemd/system/fprintd.service.d 2>/dev/null || true
	rm -f /var/lib/vfs495-driver/commands.bin
	# Fingerprint login through this package's PAM profile: Ubuntu's fprintd profile allows one
	# try, and the lock screen uses it (its password conversation claims the reader first); a
	# swipe reader deserves a second. Done once: later changes by the admin are kept.
	if ! grep -qx vfs495-driver /var/lib/pam/seen 2>/dev/null; then
		pam-auth-update --package --remove fprintd --enable vfs495-driver || true
	fi
	systemctl daemon-reload 2>/dev/null || true
	systemctl try-restart fprintd 2>/dev/null || true
fi
# after installing, and after every upgrade of libfprint (file triggers): is the reader usable?
if [ "$1" = configure ] || [ "$1" = triggered ]; then
	if ! vfs495-check --quiet; then
		echo "" >&2
		echo "*** vfs495-driver: fingerprint login will not work until the driver is rebuilt. ***" >&2
		echo "" >&2
		logger -p auth.warning -t vfs495-driver \
			"libfprint does not load the VFS495 driver; rebuild it: driver/tools/install-driver.sh" 2>/dev/null || true
	fi
fi
exit 0
